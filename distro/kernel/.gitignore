# Kernel build output. Everything here is regenerated by `make`, and the
# objects are per-kernel: committing one would be committing a binary that is
# wrong for every machine but the one that built it.
*.o
*.ko
*.mod
*.mod.c
*.symvers
*.order
.*.cmd
.*.d
.tmp_versions/

# Generated from the build host's BTF by bpftool. 117k lines, and reproducing
# it is one command -- see bpf/Makefile.
vmlinux.h
